# --- Database ---
# MongoDB connection string. Required (app throws on boot if missing).
# Used in src/lib/db.ts
DB_URI=

# --- Sessions / Auth ---
# Secret key used to sign/verify JWT session cookies. Required (app throws on boot if missing).
# Used in src/lib/sessions.ts
SESSION_SECRET=

# Email address of the protected super admin account (cannot be demoted/deactivated/deleted).
# Used in src/actions/auth.ts
SUPER_ADMIN_EMAIL=

# --- Site URL ---
# Public base URL of the site, used to build links in verification/reset emails
# and as a fallback for src/utils/appStore.ts. Exposed to the client (NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMTP (nodemailer) ---
# Used in src/lib/mail/sendMail.ts
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Cloudinary (image uploads) ---
# Used in src/lib/media/cloudinary.ts and src/actions/cloudinary.ts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
